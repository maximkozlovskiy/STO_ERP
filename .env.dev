# STO ERP — локальна розробка
# Використовується з: docker-compose -f docker-compose.dev.yml up -d
# НЕ комітити реальні секрети — це дефолтні dev-значення

# PostgreSQL
POSTGRES_USER=sto
POSTGRES_PASSWORD=sto_dev_secret
POSTGRES_DB=sto_erp
DATABASE_URL=postgresql://sto:sto_dev_secret@localhost:5432/sto_erp

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=sto_minio
MINIO_SECRET_KEY=sto_minio_secret
MINIO_BUCKET=sto-files
MINIO_USE_SSL=false

# JWT (dev-only — змінити в production!)
JWT_ACCESS_SECRET=dev_access_secret_change_in_prod
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Шифрування секретів at-rest (dev-only ключ)
NOTIFICATION_ENC_KEY=dev_notification_enc_key_change_in_prod

# API
PORT=3000
NODE_ENV=development
TZ=Europe/Kyiv

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public-facing web URL — для серверних shareable посилань (SMS WO_ESTIMATE_READY тощо).
WEB_PUBLIC_URL=http://localhost:3001

# Sentry (R4: реальні DSN прибрано з комміт-файлу — .env.dev коммітиться dev-shared. Локально
# впишіть свій DSN; у проді інсталятор/оператор задає реальні значення. Sentry вимкнено без DSN.)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
# ^ Browser JavaScript project (Web/Next.js)
NEXT_PUBLIC_APP_VERSION=0.1.0
