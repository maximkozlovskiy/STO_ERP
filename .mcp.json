{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.80", "--browser", "chromium", "--headless"],
      "env": {
        "PLAYWRIGHT_BASE_URL": "http://localhost:3001"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headersHelper": "node scripts/mcp/github-auth-headers.cjs"
    },
    "postgres": {
      "command": "wsl",
      "args": ["-e", "sh", "scripts/mcp/postgres-mcp.sh"],
      "env": {
        "DATABASE_URI": "${STO_DB_READONLY_URI:-}",
        "WSLENV": "DATABASE_URI"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.4.4"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.11.0",
        "--headless",
        "--isolated",
        "--no-usage-statistics",
        "--viewport",
        "1440x900"
      ]
    }
  }
}
