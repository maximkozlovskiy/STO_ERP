:80 {
    # API
    handle /api/* {
        reverse_proxy api:3000
    }

    # Web static
    handle {
        reverse_proxy web:80
    }

    # Compression
    encode gzip

    # Access log
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
