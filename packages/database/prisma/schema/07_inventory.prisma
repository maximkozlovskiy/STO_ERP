model StockItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  goodId      String    @db.Uuid
  warehouseId String    @db.Uuid
  quantity    Float     @default(0)
  reserved    Float     @default(0)
  minStock    Float?
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  good      Good      @relation(fields: [goodId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([orgId, goodId, warehouseId])
  // [orgId,warehouseId] надлишковий — префікс [orgId,warehouseId,deletedAt] нижче
  @@index([orgId, warehouseId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("stock_items")
}

// Append-only — ніколи не редагується
model StockMovement {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String            @db.Uuid
  goodId          String            @db.Uuid
  warehouseId     String            @db.Uuid
  type            StockMovementType
  quantity        Float
  price           Decimal?          @db.Decimal(12, 2)
  documentType    String?
  documentId      String?           @db.Uuid
  batchId         String?           @db.Uuid
  notes           String?
  createdAt       DateTime          @default(now())
  createdBy       String?           @db.Uuid
  unitOfMeasureId String?           @db.Uuid

  good          Good           @relation(fields: [goodId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  batch         StockBatch?    @relation("BatchMovements", fields: [batchId], references: [id])
  sourceBatch   StockBatch?    @relation("BatchSource")
  unitOfMeasure UnitOfMeasure? @relation("StockMovementUoM", fields: [unitOfMeasureId], references: [id])

  @@index([orgId, goodId, warehouseId])
  @@index([orgId, warehouseId, createdAt])
  @@index([orgId, documentType, documentId])
  // sto-optimize: covers `byDocument` StockMovement query (orgId + [goodId?] +
  // createdAt DESC sort), used when goodId filter present or no warehouseId.
  // Без цього індекса Postgres робив seqscan + sort на take:3000 рядках.
  @@index([orgId, goodId, createdAt])
  @@index([orgId, createdAt])
  @@map("stock_movements")
}

model StockBatch {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String    @db.Uuid
  goodId              String    @db.Uuid
  warehouseId         String    @db.Uuid
  purchaseOrderLineId String?   @db.Uuid
  stockMovementId     String    @unique @db.Uuid
  batchNumber         String?
  expiryDate          DateTime?
  receivedQty         Float
  remainingQty        Float
  costPrice           Decimal   @db.Decimal(12, 2)
  salePrice           Decimal   @db.Decimal(12, 2)
  isActive            Boolean   @default(true)
  unitOfMeasureId     String?   @db.Uuid
  syncVersion         BigInt    @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  good              Good               @relation(fields: [goodId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  sourceMovement    StockMovement      @relation("BatchSource", fields: [stockMovementId], references: [id])
  unitOfMeasure     UnitOfMeasure?     @relation("StockBatchUoM", fields: [unitOfMeasureId], references: [id])
  consumptions      BatchConsumption[]
  workOrderParts    WorkOrderPart[]
  movements         StockMovement[]    @relation("BatchMovements")

  // [orgId,goodId,warehouseId,isActive] надлишковий — префікс 5-колонкового індексу нижче
  @@index([orgId, warehouseId, isActive, createdAt])
  @@index([orgId, goodId, expiryDate])
  @@index([orgId, syncVersion])
  // sto-optimize: covers `byBatch` query (orgId + optional warehouseId/goodId +
  // createdAt DESC sort) without isActive predicate. Існуючий
  // (orgId, warehouseId, isActive, createdAt) не вибирається коли WHERE не має
  // isActive — Postgres вимагає leading-cols match.
  @@index([orgId, createdAt])
  // sto-optimize (2026-09-02): hot-path BatchService.consumeBatch (FIFO/LIFO):
  // WHERE (orgId, goodId, warehouseId, isActive) + ORDER BY createdAt asc/desc.
  // Існуючий (orgId, goodId, warehouseId, isActive) не має createdAt — Postgres
  // робить external sort на кожній сторінці PAGE=100 при кожному WRITEOFF/WO-COMPLETED.
  // Migration: 20260902200000_add_batch_consume_hotpath_index
  @@index([orgId, goodId, warehouseId, isActive, createdAt])
  @@map("stock_batches")
}

// Append-only — фіксує яка партія використана в документі
model BatchConsumption {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @db.Uuid
  batchId        String   @db.Uuid
  goodId         String   @db.Uuid
  quantity       Float
  documentType   String
  documentId     String   @db.Uuid
  documentLineId String?  @db.Uuid
  createdAt      DateTime @default(now())
  createdBy      String?  @db.Uuid

  batch StockBatch @relation(fields: [batchId], references: [id])

  // [orgId,batchId] надлишковий — префікс [orgId,batchId,createdAt] нижче
  @@index([orgId, documentType, documentId])
  @@index([orgId, batchId, createdAt])
  @@map("batch_consumptions")
}

model PricingRule {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String          @db.Uuid
  name         String
  type         PricingRuleType
  priority     Int             @default(10)
  goodId       String?         @db.Uuid
  goodCategory String?
  goodType     String?
  brandId      String?         @db.Uuid
  supplierId   String?         @db.Uuid
  percentValue Decimal?        @db.Decimal(6, 2)
  fixedAmount  Decimal?        @db.Decimal(12, 2)
  fixedPrice   Decimal?        @db.Decimal(12, 2)
  roundTo      Decimal?        @db.Decimal(6, 2)
  isActive     Boolean         @default(true)
  syncVersion  BigInt          @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  good         Good?             @relation(fields: [goodId], references: [id])
  brand        Brand?            @relation(fields: [brandId], references: [id])
  supplier     Counterparty?     @relation("PricingRuleSupplier", fields: [supplierId], references: [id])
  tiers        PricingRuleTier[]
  priceHistory PriceHistory[]

  @@index([orgId, isActive, priority])
  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@index([orgId, brandId])
  @@index([orgId, supplierId])
  @@map("pricing_rules")
}

model PricingRuleTier {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pricingRuleId String   @db.Uuid
  costMin       Decimal  @db.Decimal(12, 2)
  costMax       Decimal? @db.Decimal(12, 2)
  percentValue  Decimal  @db.Decimal(6, 2)
  sortOrder     Int      @default(0)

  pricingRule PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)

  @@index([pricingRuleId, costMin])
  @@map("pricing_rule_tiers")
}

// Append-only — лог усіх змін ціни продажу
model PriceHistory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @db.Uuid
  goodId        String   @db.Uuid
  oldPrice      Decimal? @db.Decimal(12, 2)
  newPrice      Decimal  @db.Decimal(12, 2)
  costPrice     Decimal? @db.Decimal(12, 2)
  reason        String?
  batchId       String?  @db.Uuid
  pricingRuleId String?  @db.Uuid
  createdAt     DateTime @default(now())
  createdBy     String?  @db.Uuid

  good        Good         @relation(fields: [goodId], references: [id])
  pricingRule PricingRule? @relation(fields: [pricingRuleId], references: [id])

  @@index([orgId, goodId, createdAt])
  @@map("price_history")
}

model PurchaseOrder {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String              @db.Uuid
  supplierId   String              @db.Uuid
  warehouseId  String              @db.Uuid
  contractId   String?             @db.Uuid
  number       String
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Decimal             @default(0) @db.Decimal(12, 2)
  totalVat     Decimal             @default(0) @db.Decimal(12, 2)
  // Мультивалюта (Фаза 3): валюта документа. totalAmount/totalVat/рядки — у ЦІЙ валюті; totalAmountBase —
  // у БАЗОВІЙ валюті org по курсу на documentDate; rateUsed — курс.
  // TD1 (2026-09-14): currencyId NOT NULL — база сідиться на setup, create завжди резолвить.
  currencyId      String           @db.Uuid
  totalAmountBase Decimal?         @db.Decimal(12, 2)
  rateUsed        Decimal?         @db.Decimal(18, 6)
  // Payables FX (Фаза 5): сукупні ПРОВЕДЕНІ оплати постачальнику у валюті PO (вісь ОПЛАТИ, окрема від
  // status=вісь ПРИЙОМУ). paidAt — дата коли PO вперше повністю сплачено (тригер realized FX). «Повністю
  // сплачено» — похідне (paidAmount >= totalAmount − 0.005). Монотонний (CONFIRMED SP термінальний).
  paidAmount   Decimal             @default(0) @db.Decimal(12, 2)
  paidAt       DateTime?           @db.Date
  notes        String?
  documentDate DateTime            @default(now()) @db.Date
  paymentDate  DateTime?           @db.Date
  pricedAt     DateTime?
  // Доставка (трекінг за накладною служби доставки, напр. Нова Пошта). Незалежні від FSM закупівлі.
  trackingNumber          String? // номер накладної (ЕН)
  deliveryStatus          DeliveryStatus? // нормалізований статус (null поки ЕН не вказано)
  deliveryStatusRaw       String? // сирий текст статусу служби доставки (для тултипа UI)
  deliveryStatusUpdatedAt DateTime? // час останнього оновлення статусу доставки
  syncVersion  BigInt              @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  supplier         Counterparty          @relation(fields: [supplierId], references: [id])
  warehouse        Warehouse             @relation(fields: [warehouseId], references: [id])
  contract         CounterpartyContract? @relation(fields: [contractId], references: [id])
  currency         Currency?             @relation("PurchaseOrderCurrency", fields: [currencyId], references: [id])
  lines            PurchaseOrderLine[]
  supplierPayments SupplierPayment[]
  stockDocuments   StockDocument[]
  supplierReturns  SupplierReturn[]

  @@index([orgId, status, deletedAt, createdAt])
  @@index([orgId, syncVersion])
  @@index([orgId, deletedAt, createdAt])
  @@index([orgId, documentDate, deletedAt])
  @@index([orgId, deliveryStatus, deletedAt])
  // T14: ручний partial-unique (orgId, number) WHERE deletedAt IS NULL — міграція 20260909210000 (Prisma не виражає partial-unique у @@unique).
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @db.Uuid
  purchaseOrderId String    @db.Uuid
  goodId          String    @db.Uuid
  quantity        Float
  price           Decimal   @db.Decimal(12, 2)
  vatRate         Decimal   @default(0) @db.Decimal(5, 2)
  vatAmount       Decimal   @default(0) @db.Decimal(12, 2)
  receivedQty     Float     @default(0)
  pricedSalePrice Decimal?  @db.Decimal(12, 2)
  pricingRuleName String?
  unitOfMeasureId String?   @db.Uuid
  syncVersion     BigInt    @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  good          Good           @relation(fields: [goodId], references: [id])
  unitOfMeasure UnitOfMeasure? @relation("POLineUoM", fields: [unitOfMeasureId], references: [id])
  stockBatches  StockBatch[]

  @@index([purchaseOrderId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("purchase_order_lines")
}

model SupplierReturn {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String               @db.Uuid
  supplierId      String               @db.Uuid
  warehouseId     String               @db.Uuid
  purchaseOrderId String?              @db.Uuid  // джерело-замовлення повернення; nullable
  number          String
  status          SupplierReturnStatus @default(DRAFT)
  totalAmount     Decimal              @default(0) @db.Decimal(12, 2)
  notes           String?
  documentDate    DateTime             @default(now()) @db.Date
  syncVersion     BigInt               @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  supplier      Counterparty         @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse            @relation(fields: [warehouseId], references: [id])
  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  lines         SupplierReturnLine[]

  @@index([orgId, status, deletedAt, createdAt])
  @@index([orgId, syncVersion])
  @@index([orgId, deletedAt, createdAt])
  @@index([orgId, documentDate, deletedAt])
  @@index([orgId, purchaseOrderId, deletedAt, createdAt])
  // T14: ручний partial-unique (orgId, number) WHERE deletedAt IS NULL — міграція 20260909210000 (Prisma не виражає partial-unique у @@unique).
  @@map("supplier_returns")
}

model SupplierReturnLine {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String    @db.Uuid
  supplierReturnId String    @db.Uuid
  goodId           String    @db.Uuid
  quantity         Float
  price            Decimal   @db.Decimal(12, 2)
  unitOfMeasureId  String?   @db.Uuid
  syncVersion      BigInt    @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  supplierReturn SupplierReturn @relation(fields: [supplierReturnId], references: [id])
  good           Good           @relation(fields: [goodId], references: [id])
  unitOfMeasure  UnitOfMeasure? @relation("SupplierReturnLineUoM", fields: [unitOfMeasureId], references: [id])

  @@index([supplierReturnId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("supplier_return_lines")
}

model SupplierPayment {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String                @db.Uuid
  supplierId      String                @db.Uuid
  purchaseOrderId String?               @db.Uuid
  sourceType      PaymentSourceType
  bankAccountId   String?               @db.Uuid
  cashRegisterId  String?               @db.Uuid
  number          String
  status          SupplierPaymentStatus @default(DRAFT)
  amount          Decimal               @db.Decimal(12, 2)
  // Мультивалюта (Фаза 3): валюта оплати (з source-рахунку bank/cash — той завжди має валюту).
  // amount — у ЦІЙ валюті; totalAmountBase — у БАЗОВІЙ валюті org по курсу на дату confirm; rateUsed — курс.
  // TD1 (2026-09-14): currencyId NOT NULL — source-рахунок завжди має currencyId + backfill.
  currencyId      String                @db.Uuid
  totalAmountBase Decimal?              @db.Decimal(12, 2)
  rateUsed        Decimal?              @db.Decimal(18, 6)
  method          String
  notes           String?
  documentDate    DateTime              @default(now()) @db.Date
  syncVersion     BigInt                @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?

  supplier      Counterparty   @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  bankAccount   BankAccount?   @relation(fields: [bankAccountId], references: [id])
  cashRegister  CashRegister?  @relation(fields: [cashRegisterId], references: [id])
  currency      Currency?      @relation("SupplierPaymentCurrency", fields: [currencyId], references: [id])

  // +createdAt: дефолтний unfiltered list сортує createdAt desc → covering (як решта документів)
  @@index([orgId, deletedAt, createdAt])
  @@index([orgId, supplierId, createdAt])
  @@index([orgId, status, createdAt])
  // sto-optimize (2026-08-30): findAll(purchaseOrderId=?) + getSchedule nested include
  // + groupBy(purchaseOrderId=null) — FK PO axis не було покрито.
  @@index([orgId, purchaseOrderId, deletedAt])
  @@index([orgId, syncVersion])
  // T14: ручний partial-unique (orgId, number) WHERE deletedAt IS NULL — міграція 20260909210000 (Prisma не виражає partial-unique у @@unique).
  @@map("supplier_payments")
}

model StockDocument {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String              @db.Uuid
  branchId          String              @db.Uuid
  number            String
  type              StockDocumentType
  status            StockDocumentStatus @default(DRAFT)
  warehouseId       String              @db.Uuid
  targetWarehouseId String?             @db.Uuid
  purchaseOrderId   String?             @db.Uuid  // джерело-замовлення (для RECEIPT/OPENING); nullable
  notes             String?
  confirmedAt       DateTime?
  confirmedBy       String?             @db.Uuid
  documentDate      DateTime            @default(now()) @db.Date
  syncVersion       BigInt              @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  branch          GarageBranch        @relation(fields: [branchId], references: [id])
  warehouse       Warehouse           @relation("SourceWarehouse", fields: [warehouseId], references: [id])
  targetWarehouse Warehouse?          @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id])
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  lines           StockDocumentLine[]

  @@index([orgId, status, deletedAt, createdAt])
  @@index([orgId, type, deletedAt, createdAt])
  @@index([orgId, syncVersion])
  @@index([orgId, deletedAt, createdAt])
  @@index([orgId, documentDate, deletedAt])
  @@index([orgId, purchaseOrderId, deletedAt, createdAt])
  // T14: ручний partial-unique (orgId, number) WHERE deletedAt IS NULL — міграція 20260909210000 (Prisma не виражає partial-unique у @@unique).
  @@map("stock_documents")
}

model StockDocumentLine {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @db.Uuid
  stockDocumentId String    @db.Uuid
  goodId          String    @db.Uuid
  quantity        Float
  price           Decimal?  @db.Decimal(12, 2)
  unitOfMeasureId String?   @db.Uuid
  syncVersion     BigInt    @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  stockDocument StockDocument  @relation(fields: [stockDocumentId], references: [id])
  good          Good           @relation(fields: [goodId], references: [id])
  unitOfMeasure UnitOfMeasure? @relation("SDLineUoM", fields: [unitOfMeasureId], references: [id])

  @@index([orgId, stockDocumentId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("stock_document_lines")
}
