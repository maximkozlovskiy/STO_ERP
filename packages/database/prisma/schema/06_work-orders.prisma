model WorkOrder {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String            @db.Uuid
  branchId         String            @db.Uuid
  vehicleId        String            @db.Uuid
  counterpartyId   String            @db.Uuid
  contractId       String?           @db.Uuid
  liftId           String?           @db.Uuid
  number           String
  status           WorkOrderStatus   @default(DRAFT)
  priority         WorkOrderPriority @default(NORMAL)
  repairCategory   RepairCategory?
  description      String?
  inMileage        Int?
  outMileage       Int?
  plannedAt        DateTime?
  dueDate          DateTime?
  plannedHours     Float?
  actualHours      Float?
  completedAt      DateTime?
  warrantyUntil    DateTime?
  clientApproval   Boolean           @default(false)
  totalLabor       Decimal           @default(0) @db.Decimal(12, 2)
  totalActualLabor Decimal           @default(0) @db.Decimal(12, 2)
  totalParts       Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal           @default(0) @db.Decimal(12, 2)
  totalVat         Decimal           @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal           @default(0) @db.Decimal(12, 2)
  // Мультивалюта (Фаза 3): валюта документа. totalAmount/totalLabor/…/paidAmount — у ЦІЙ валюті;
  // totalAmountBase — сума у БАЗОВІЙ валюті org по курсу на documentDate; rateUsed — курс.
  // TD1 (2026-09-14): currencyId NOT NULL — база сідиться на setup, create завжди резолвить.
  currencyId       String            @db.Uuid
  totalAmountBase  Decimal?          @db.Decimal(12, 2)
  rateUsed         Decimal?          @db.Decimal(18, 6)
  documentDate     DateTime          @default(now()) @db.Date
  shareToken       String?           @unique
  syncVersion      BigInt            @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  branch           GarageBranch          @relation(fields: [branchId], references: [id])
  vehicle          Vehicle               @relation(fields: [vehicleId], references: [id])
  counterparty     Counterparty          @relation(fields: [counterpartyId], references: [id])
  contract         CounterpartyContract? @relation(fields: [contractId], references: [id])
  lift             Lift?                 @relation(fields: [liftId], references: [id])
  currency         Currency?             @relation("WorkOrderCurrency", fields: [currencyId], references: [id])
  lines            WorkOrderLine[]
  parts            WorkOrderPart[]
  payments         Payment[]
  invoices         Invoice[]
  calendarSlots    CalendarSlot[]
  completionActs   CompletionAct[]
  media            WorkOrderMedia[]
  warranties       Warranty[]
  claimWarranties  Warranty[]            @relation("WarrantyClaim")
  inspectionReport InspectionReport?

  // +createdAt хвостом: list-page фільтрує по status + сортує createdAt desc → covering (без Sort node)
  @@index([orgId, status, deletedAt, createdAt])
  @@index([orgId, status, branchId, deletedAt])
  @@index([orgId, syncVersion])
  @@index([orgId, counterpartyId])
  // Work orders of one vehicle: mileage history (BR-VEH-001) and the vehicleId list filter.
  @@index([orgId, vehicleId, deletedAt])
  @@index([orgId, branchId, deletedAt])
  @@index([orgId, completedAt, deletedAt])
  @@index([orgId, documentDate, deletedAt])
  // FK index for liftId — supports "work orders by lift" queries (dashboards,
  // utilization reports). Partial-style not required because nullable FK is
  // sparse and B-tree skips NULL by default.
  @@index([orgId, liftId])
  // Covering для default sort: WHERE (orgId, deletedAt) + ORDER BY createdAt DESC + take 20.
  // Same convention as Invoice/PurchaseOrder/StockDocument — eliminates the in-memory Sort node
  // for the most common list query (no filters applied).
  @@index([orgId, deletedAt, createdAt])
  // T14: ручний partial-unique (orgId, number) WHERE deletedAt IS NULL — міграція 20260909210000 (Prisma не виражає partial-unique у @@unique).
  @@map("work_orders")
}

model WorkOrderLine {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  workOrderId String    @db.Uuid
  workId      String    @db.Uuid
  employeeId  String    @db.Uuid
  liftId      String?   @db.Uuid
  normoHours  Float
  actualHours Float?
  price       Decimal   @db.Decimal(12, 2)
  amount      Decimal   @db.Decimal(12, 2)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workOrder       WorkOrder               @relation(fields: [workOrderId], references: [id])
  work            Work                    @relation(fields: [workId], references: [id])
  employee        Employee                @relation(fields: [employeeId], references: [id])
  lift            Lift?                   @relation(fields: [liftId], references: [id])
  assistEmployees WorkOrderLineEmployee[]

  @@index([orgId, workOrderId, deletedAt])
  @@index([orgId, employeeId])
  @@index([workOrderId, deletedAt])
  @@index([orgId, syncVersion]) // T5: delta-pull курсор (sync.service where orgId+syncVersion>since)
  @@map("work_order_lines")
}

model WorkOrderLineEmployee {
  workOrderLineId String        @db.Uuid
  employeeId      String        @db.Uuid
  line            WorkOrderLine @relation(fields: [workOrderLineId], references: [id])
  employee        Employee      @relation(fields: [employeeId], references: [id])

  @@id([workOrderLineId, employeeId])
  @@map("work_order_line_employees")
}

model WorkOrderPart {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @db.Uuid
  workOrderId     String    @db.Uuid
  goodId          String    @db.Uuid
  warehouseId     String    @db.Uuid
  quantity        Float
  price           Decimal   @db.Decimal(12, 2)
  amount          Decimal   @db.Decimal(12, 2)
  batchId         String?   @db.Uuid
  batchCostPrice  Decimal?  @db.Decimal(12, 2)
  unitOfMeasureId String?   @db.Uuid
  syncVersion     BigInt    @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  workOrder     WorkOrder      @relation(fields: [workOrderId], references: [id])
  good          Good           @relation(fields: [goodId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  batch         StockBatch?    @relation(fields: [batchId], references: [id])
  unitOfMeasure UnitOfMeasure? @relation("WorkOrderPartUoM", fields: [unitOfMeasureId], references: [id])

  @@index([orgId, workOrderId, deletedAt])
  @@index([orgId, syncVersion]) // T5: delta-pull курсор
  @@map("work_order_parts")
}

model InvoiceLine {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @db.Uuid
  invoiceId       String   @db.Uuid
  goodId          String?  @db.Uuid
  workId          String?  @db.Uuid
  description     String
  quantity        Float
  unitPrice       Decimal  @db.Decimal(12, 2)
  vatRate         Decimal  @default(20) @db.Decimal(5, 2)
  priceWithoutVat Decimal  @db.Decimal(12, 2)
  vatAmount       Decimal  @db.Decimal(12, 2)
  priceWithVat    Decimal  @db.Decimal(12, 2)
  sortOrder       Int      @default(0)
  unitOfMeasureId String?  @db.Uuid
  createdAt       DateTime @default(now())

  invoice       Invoice        @relation(fields: [invoiceId], references: [id])
  good          Good?          @relation(fields: [goodId], references: [id])
  work          Work?          @relation(fields: [workId], references: [id])
  unitOfMeasure UnitOfMeasure? @relation("InvoiceLineUoM", fields: [unitOfMeasureId], references: [id])

  @@index([orgId, invoiceId])
  @@map("invoice_lines")
}

model MaintenanceSchedule {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                  String    @db.Uuid
  vehicleId              String    @db.Uuid
  maintenanceType        String    @default("REGULAR")
  intervalDays           Int?
  intervalMileage        Int?
  lastMaintenanceDate    DateTime?
  lastMaintenanceMileage Int?
  nextMaintenanceDate    DateTime?
  nextMaintenanceMileage Int?
  notes                  String?
  isActive               Boolean   @default(true)
  syncVersion            BigInt    @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([orgId, vehicleId, deletedAt])
  @@index([orgId, nextMaintenanceDate])
  @@index([orgId, syncVersion])
  @@map("maintenance_schedules")
}

model CompletionAct {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String              @db.Uuid
  workOrderId String              @db.Uuid
  number      String
  status      CompletionActStatus @default(DRAFT)
  signedAt    DateTime?
  signedBy    String?
  clientPhone String?
  notes       String?
  syncVersion BigInt              @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  // R1: ручний partial-unique (orgId, number) WHERE deletedAt IS NULL — міграція 20260910120000.
  // Було plain @@unique([orgId, number]), яке рахувало й soft-deleted → після видалення акта номер
  // не переюзувався (P2002). Тепер узгоджено з 7 документними таблицями T14 (Prisma не виражає
  // partial-unique у @@unique).
  // Covering: findAll(orgId, workOrderId?) sorted by createdAt DESC + take 100.
  // Замінює `(orgId, workOrderId, deletedAt)` → робить Index Scan + sort node у 0.
  @@index([orgId, workOrderId, deletedAt, createdAt])
  @@index([orgId, syncVersion])
  @@map("completion_acts")
}

model WorkOrderMedia {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @db.Uuid
  workOrderId String   @db.Uuid
  fileKey     String
  filename    String
  mimeType    String
  sizeBytes   Int
  uploadedBy  String   @db.Uuid
  createdAt   DateTime @default(now())
  syncVersion BigInt   @default(0)

  org       Organisation @relation(fields: [orgId], references: [id])
  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id])
  uploader  Employee     @relation(fields: [uploadedBy], references: [id])

  // Covering index: findAll сортує по createdAt DESC (work-order-media.service.findAll, take:50).
  // Раніше (orgId, workOrderId) покривав WHERE але вимагав Sort node поверх Index Scan.
  // (orgId, workOrderId, createdAt) → Postgres віддає рядки в індекс-order, sort node зникає.
  @@index([orgId, workOrderId, createdAt])
  @@index([orgId, syncVersion])
  @@map("work_order_media")
}

model Warranty {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @db.Uuid
  workOrderId     String    @db.Uuid
  workOrderLineId String?   @db.Uuid
  workOrderPartId String?   @db.Uuid
  counterpartyId  String    @db.Uuid
  expiresAt       DateTime
  description     String    @default("")
  claimedAt       DateTime?
  claimWoId       String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  syncVersion     BigInt    @default(0)

  org          Organisation @relation(fields: [orgId], references: [id])
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  claimWo      WorkOrder?   @relation("WarrantyClaim", fields: [claimWoId], references: [id])

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  // Covering index: findByCounterparty/findByWorkOrder сортують по createdAt DESC,
  // findExpiring сортує по expiresAt ASC. Раніше (orgId, counterpartyId, deletedAt) без
  // createdAt → Sort node поверх Index Scan. Додаємо createdAt у covering для DESC-sort.
  @@index([orgId, counterpartyId, deletedAt, createdAt])
  @@index([orgId, expiresAt, deletedAt])
  // Covering index for getLinkedDocuments + getLinkedCounts (linked-docs panel).
  // WHERE: workOrderId/orgId/deletedAt + ORDER BY createdAt DESC.
  @@index([orgId, workOrderId, deletedAt, createdAt])
  @@map("warranties")
}

model InspectionReport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @db.Uuid
  workOrderId String   @db.Uuid
  mileage     Int?
  points      Json     @default("[]")
  createdBy   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  syncVersion BigInt   @default(0)

  org       Organisation @relation(fields: [orgId], references: [id])
  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id])
  employee  Employee     @relation(fields: [createdBy], references: [id])

  @@unique([workOrderId])
  @@index([orgId, syncVersion])
  @@map("inspection_reports")
}
