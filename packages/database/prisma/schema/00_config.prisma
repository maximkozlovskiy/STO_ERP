generator client {
  provider        = "prisma-client-js"
  // prismaSchemaFolder прибрано: стабілізувався у Prisma 6, прапорець більше не потрібен
  // (шлях до теки схеми тепер у prisma.config.ts). typedSql лишається preview.
  previewFeatures = ["typedSql"]
}

datasource db {
  // `url` ПРИБРАНО: Prisma 7 більше не підтримує його у схемі (P1012). Рядок підключення
  // для Migrate/CLI тепер у prisma.config.ts, а рантайм отримує його через adapter,
  // переданий у конструктор PrismaClient.
  provider = "postgresql"
}
