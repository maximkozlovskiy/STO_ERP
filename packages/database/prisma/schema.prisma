// ─── CURRENCIES & FINANCIAL ACCOUNTS ──────────────────────────────────────────

model Currency {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String    @db.Uuid
  name              String
  fullName          String?
  internationalName String?
  code              String
  symbol            String?
  isSystem          Boolean   @default(false)
  nbuFetchEnabled   Boolean   @default(false)
  nbuMarkupPercent  Decimal?  @db.Decimal(6, 2)
  syncVersion       BigInt    @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  organisation  Organisation   @relation(fields: [orgId], references: [id])
  exchangeRates ExchangeRate[]
  bankAccounts  BankAccount[]
  cashRegisters CashRegister[]

  @@unique([orgId, code])
  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("currencies")
}

model ExchangeRate {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  currencyId  String    @db.Uuid
  date        DateTime  @db.Date
  rate        Decimal   @db.Decimal(18, 6)
  coefficient Decimal   @default(1) @db.Decimal(18, 6)
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organisation Organisation @relation(fields: [orgId], references: [id])
  currency     Currency     @relation(fields: [currencyId], references: [id])

  @@unique([orgId, currencyId, date])
  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("exchange_rates")
}

model BankAccount {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  name        String
  ibanUA      String
  currencyId  String    @db.Uuid
  bankName    String?
  branchId    String?   @db.Uuid
  mfo         String?
  edrpou      String?
  bankAddress String?
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organisation     Organisation      @relation(fields: [orgId], references: [id])
  currency         Currency          @relation(fields: [currencyId], references: [id])
  branch           GarageBranch?     @relation(fields: [branchId], references: [id])
  primaryForOrgs   Organisation[]    @relation("OrgPrimaryBankAccount")
  supplierPayments SupplierPayment[]
  payments         Payment[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("bank_accounts")
}

model CashRegister {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  name        String
  currencyId  String    @db.Uuid
  branchId    String    @db.Uuid
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organisation     Organisation      @relation(fields: [orgId], references: [id])
  currency         Currency          @relation(fields: [currencyId], references: [id])
  branch           GarageBranch      @relation(fields: [branchId], references: [id])
  supplierPayments SupplierPayment[]
  payments         Payment[]
  cashShifts       CashShift[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("cash_registers")
}

// Касова зміна (ПРРО). Чек пробивається лише у відкриту зміну; закриття = Z-звіт (щодня).
// checkboxAccessToken — короткоживучий cashier-token від Checkbox (шифрується at-rest).
model CashShift {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String          @db.Uuid
  branchId            String          @db.Uuid
  cashRegisterId      String          @db.Uuid
  checkboxShiftId     String? // id зміни у Checkbox
  status              CashShiftStatus @default(OPEN)
  openedById          String?         @db.Uuid // Employee, що відкрив
  openedAt            DateTime        @default(now())
  closedAt            DateTime?
  zReportId           String? // id Z-звіту при закритті
  checkboxAccessToken String? // cashier access-token (шифрується — див. prisma.service ENCRYPTED_FIELDS)
  tokenExpiresAt      DateTime?
  syncVersion         BigInt          @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])

  // Один OPEN на касу гарантуємо частковим unique-індексом на рівні БД (CLOSED багато, тому
  // повний @@unique не годиться; Prisma не підтримує WHERE у @@unique → індекс живе у міграції:
  // "cash_shifts_one_open_per_register_uq" WHERE status='OPEN' AND deletedAt IS NULL). Захищає від
  // гонки findFirst-then-create у open() (у т.ч. AUTO_OPEN у processor concurrency:3).
  @@index([orgId, branchId, status])
  @@index([orgId, cashRegisterId, status])
  @@map("cash_shifts")
}

// ─── USER PREFERENCES ────────────────────────────────────

model UserPreference {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @db.Uuid
  employeeId String   @db.Uuid
  key        String
  value      Json
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([orgId, employeeId, key])
  // sto-optimize: @@index([orgId, employeeId]) is redundant — @@unique([orgId, employeeId, key])
  // covers prefix lookups on (orgId, employeeId).
  @@map("user_preferences")
}

// ─── SYSTEM TEMPLATES ────────────────────────────────────

// Глобальні шаблони довідників — не per-org, заповнюються через seed.
// Використовуються як джерело для масового заповнення:
// валюти, одиниці виміру, методи оплати, категорії робіт.
model SystemTemplate {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String // 'currency' | 'unit_of_measure' | 'payment_method' | 'work_category'
  key        String // унікальний ключ: 'USD', 'шт', 'cash', 'MAINTENANCE'
  name       String // відображувана назва для UI
  data       Json // повний набір полів для створення запису
  sortOrder  Int    @default(0)

  @@unique([entityType, key])
  @@index([entityType, sortOrder])
  @@map("system_templates")
}
