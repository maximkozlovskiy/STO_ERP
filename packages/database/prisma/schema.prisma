generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  RECEPTIONIST
  MECHANIC
  STOREKEEPER
  ACCOUNTANT
  XLSX_MANAGER
  CLIENT
}

enum WorkOrderStatus {
  DRAFT
  ESTIMATE
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  INVOICED
  PAID
  ARCHIVED
  CANCELLED
}

enum ZoneType {
  MECHANICAL
  BODY
  TIRE
  WASH
  ELECTRICAL
  OTHER
}

enum LiftType {
  TWO_POST
  FOUR_POST
  ALIGNMENT
  STENCIL
  STAND
  PIT
  RAMP
  OTHER
}

enum WarehouseType {
  MAIN
  WORKSHOP
  TIRE_HOTEL
  MOBILE
}

enum CounterpartyType {
  CLIENT
  SUPPLIER
  BOTH
}

enum StockMovementType {
  RECEIPT
  WRITEOFF
  TRANSFER
  RESERVATION
  RESERVATION_RELEASE
  OPENING_BALANCE
}

enum StockDocumentType {
  WRITEOFF
  TRANSFER
  OPENING_BALANCE
  RECEIPT
}

enum StockDocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum DocumentType {
  WORK_ORDER
  INVOICE
  PURCHASE_ORDER
  STOCK_RECEIPT
  STOCK_WRITEOFF
  STOCK_TRANSFER
  STOCK_OPENING
  RECONCILIATION_ACT
  COMPLETION_ACT
  COUNTERPARTY_AGREEMENT
}

enum ContractType {
  PURCHASE
  SALE
}

enum ResetPeriod {
  NEVER
  YEARLY
  MONTHLY
}

enum VatMode {
  NONE
  EXCLUSIVE
  INCLUSIVE
}

enum NotificationEventType {
  WO_CREATED
  WO_ESTIMATE_READY
  WO_APPROVED
  WO_IN_PROGRESS
  WO_COMPLETED
  WO_READY_FOR_PICKUP
  PAYMENT_RECEIVED
  INVOICE_SENT
  LOW_STOCK_ALERT
  FOLLOWUP_REMINDER
}

enum NotificationChannel {
  SMS
  VIBER
  EMAIL
}

enum SettlementTransactionType {
  CHARGE
  PAYMENT
  REFUND
  PREPAYMENT
  CREDIT_NOTE
}

// ─── PHASE 17 ENUMS ──────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  PARTIAL
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum MovementDocumentType {
  WORK_ORDER
  PURCHASE_ORDER
  STOCK_DOCUMENT
  MANUAL
}

enum CalendarSlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum CalendarSlotType {
  WORK
  MAINTENANCE
  BREAK
  MEETING
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  FIRED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RepairCategory {
  MAINTENANCE
  CURRENT_REPAIR
  MAJOR_REPAIR
  BODY_REPAIR
  DIAGNOSTICS
  WARRANTY
  SEASONAL
}

enum GoodType {
  SPARE_PART
  CONSUMABLE
  MATERIAL
  TOOL
}

enum LegalForm {
  INDIVIDUAL
  FOP
  TOV
  AT
  PP
  OTHER
}

enum LiftStatus {
  ACTIVE
  MAINTENANCE
  BROKEN
  DECOMMISSIONED
}

enum CompletionActStatus {
  DRAFT
  SIGNED
  CANCELLED
}

// ─── PHASE 19 ENUMS ──────────────────────────────────────

enum BatchCostMethod {
  FIFO
  FEFO
  LIFO
  AVG_COST
}

enum PricingRuleType {
  PERCENT
  FIXED_AMOUNT
  FIXED_PRICE
  COMPETITOR_PLUS
  COST_TIER
}

// ─── INFRASTRUCTURE ──────────────────────────────────────

model Organisation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @db.Uuid
  name          String
  edrpou        String?   @unique
  logoUrl       String?
  legalAddress  String?
  actualAddress String?
  bankAccountId String?   @db.Uuid
  syncVersion   BigInt    @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  branches              GarageBranch[]
  employees             Employee[]
  counterparties        Counterparty[]
  documentNumberConfigs DocumentNumberConfig[]
  settings              OrganisationSettings?
  notificationTemplates NotificationTemplate[]
  taxRates              TaxRate[]
  paymentMethods        PaymentMethodConfig[]
  employeeBranches      EmployeeBranch[]
  comments              Comment[]
  workOrderTemplates    WorkOrderTemplate[]
  workOrderMedia        WorkOrderMedia[]
  auditEvents           AuditEvent[]
  warranties            Warranty[]
  inspectionReports     InspectionReport[]
  webhookEndpoints      WebhookEndpoint[]
  loyaltyAccounts       LoyaltyAccount[]
  bookingRequests       BookingRequest[]
  currencies            Currency[]
  exchangeRates         ExchangeRate[]
  bankAccounts          BankAccount[]
  cashRegisters         CashRegister[]
  primaryBankAccount    BankAccount? @relation("OrgPrimaryBankAccount", fields: [bankAccountId], references: [id])

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("organisations")
}

model AuthAccount {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String    @db.Uuid
  employeeId   String    @unique @db.Uuid
  email        String
  passwordHash String
  syncVersion  BigInt    @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  employee     Employee  @relation(fields: [employeeId], references: [id])

  @@unique([orgId, email])
  @@index([orgId, email])
  @@index([orgId, syncVersion])
  @@map("auth_accounts")
}

model GarageBranch {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  name        String
  address     String
  timezone    String    @default("Europe/Kyiv")
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  org              Organisation    @relation(fields: [orgId], references: [id])
  zones            Zone[]
  warehouses       Warehouse[]
  branchSettings   BranchSettings?
  workOrders       WorkOrder[]
  stockDocuments   StockDocument[]
  employeeBranches EmployeeBranch[]
  bookingRequests  BookingRequest[]
  bankAccounts     BankAccount[]
  cashRegisters    CashRegister[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("garage_branches")
}

model Zone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  branchId    String    @db.Uuid
  name        String
  type        ZoneType
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branch        GarageBranch  @relation(fields: [branchId], references: [id])
  lifts         Lift[]
  employeeZones EmployeeZone[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("zones")
}

model Lift {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  zoneId                  String     @db.Uuid
  name                    String
  type                    LiftType
  maxWeightKg             Int?
  status                  LiftStatus @default(ACTIVE)
  serialNumber            String?
  purchaseDate            DateTime?
  warrantyUntil           DateTime?
  maintenanceIntervalDays Int?
  lastMaintenanceDate     DateTime?
  nextMaintenanceDate     DateTime?
  syncVersion             BigInt     @default(0)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  deletedAt               DateTime?

  zone           Zone            @relation(fields: [zoneId], references: [id])
  employeeLifts  EmployeeLift[]
  calendarSlots  CalendarSlot[]
  workOrderLines WorkOrderLine[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("lifts")
}

model Warehouse {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String        @db.Uuid
  branchId    String        @db.Uuid
  name        String
  type        WarehouseType @default(MAIN)
  isMain      Boolean       @default(false)
  syncVersion BigInt        @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  branch               GarageBranch        @relation(fields: [branchId], references: [id])
  stockItems           StockItem[]
  movements            StockMovement[]
  workOrderParts       WorkOrderPart[]
  purchaseOrders       PurchaseOrder[]
  stockDocumentsSource StockDocument[]     @relation("SourceWarehouse")
  stockDocumentsTarget StockDocument[]     @relation("TargetWarehouse")
  stockBatches         StockBatch[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("warehouses")
}

// ─── EMPLOYEES ───────────────────────────────────────────

model Employee {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String         @db.Uuid
  userId      String?        @db.Uuid
  firstName   String
  lastName    String
  phone       String?
  email       String?
  role        UserRole
  status      EmployeeStatus @default(ACTIVE)
  rateScheme  Json
  dateOfHire  DateTime?
  dateOfFire  DateTime?
  syncVersion BigInt         @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  allBranches Boolean @default(false)

  org                    Organisation           @relation(fields: [orgId], references: [id])
  employeeZones          EmployeeZone[]
  employeeLifts          EmployeeLift[]
  employeeWorkCategories EmployeeWorkCategory[]
  workOrderLines         WorkOrderLine[]
  workOrderLineAssists   WorkOrderLineEmployee[]
  authAccount            AuthAccount?
  employeeBranches       EmployeeBranch[]
  comments               Comment[]
  uploadedMedia          WorkOrderMedia[]
  auditEvents            AuditEvent[]
  inspectionReports      InspectionReport[]
  preferences            UserPreference[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("employees")
}

model EmployeeZone {
  employeeId String   @db.Uuid
  zoneId     String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])
  zone       Zone     @relation(fields: [zoneId], references: [id])

  @@id([employeeId, zoneId])
  @@map("employee_zones")
}

model EmployeeLift {
  employeeId String   @db.Uuid
  liftId     String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])
  lift       Lift     @relation(fields: [liftId], references: [id])

  @@id([employeeId, liftId])
  @@map("employee_lifts")
}

model EmployeeWorkCategory {
  employeeId     String       @db.Uuid
  workCategoryId String       @db.Uuid
  employee       Employee     @relation(fields: [employeeId], references: [id])
  workCategory   WorkCategory @relation(fields: [workCategoryId], references: [id])

  @@id([employeeId, workCategoryId])
  @@map("employee_work_categories")
}

// B10: Branch ACL
model EmployeeBranch {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String       @db.Uuid
  branchId   String       @db.Uuid
  orgId      String       @db.Uuid
  createdAt  DateTime     @default(now())

  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch     GarageBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId])
  @@index([orgId])
  @@index([employeeId])
  @@map("employee_branches")
}

// F8: Comments (polymorphic)
model Comment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @db.Uuid
  entityType  String
  entityId    String   @db.Uuid
  body        String
  authorId    String   @db.Uuid
  createdAt   DateTime @default(now())
  syncVersion BigInt   @default(0)

  org    Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author Employee     @relation(fields: [authorId], references: [id])

  @@index([orgId, entityType, entityId, createdAt])
  @@index([orgId, syncVersion])
  @@map("comments")
}

// F10: Work Order Templates
model WorkOrderTemplate {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  name        String
  lines       Json      @default("[]")
  parts       Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  syncVersion BigInt    @default(0)

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, deletedAt])
  @@map("work_order_templates")
}

// ─── CRM ─────────────────────────────────────────────────

model Counterparty {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String           @db.Uuid
  type          CounterpartyType
  firstName     String?
  lastName      String?
  companyName   String?
  edrpou        String?
  vatPayer      Boolean          @default(false)
  phone         String?
  email         String?
  notes         String?
  legalForm     LegalForm?
  legalAddress  String?
  actualAddress String?
  bankAccount   String?
  bankName      String?
  contactPerson String?
  taxNumber     String?
  syncVersion   BigInt           @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  org               Organisation       @relation(fields: [orgId], references: [id])
  customerGarages   CustomerGarage[]
  contracts         CounterpartyContract[]
  settlementAccount SettlementAccount?
  loyaltyAccount    LoyaltyAccount?
  purchaseOrders    PurchaseOrder[]
  invoices          Invoice[]
  workOrders        WorkOrder[]
  payments          Payment[]
  reconciliationActs ReconciliationAct[]
  goodsAsSupplier   Good[]             @relation("GoodSupplier")
  warranties        Warranty[]
  calendarSlots     CalendarSlot[]

  @@index([orgId, deletedAt])
  @@index([orgId, type, deletedAt])
  @@index([orgId, syncVersion])
  @@map("counterparties")
}

model CounterpartyContract {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String       @db.Uuid
  counterpartyId   String       @db.Uuid
  number           String
  contractType     ContractType
  startDate        DateTime     @db.Date
  endDate          DateTime?    @db.Date
  isPrimary        Boolean      @default(false)
  creditLimit      Decimal?     @db.Decimal(15, 2)
  currencyCode     String       @default("UAH") @db.VarChar(10)
  paymentDeferDays Int?
  syncVersion      BigInt       @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  counterparty   Counterparty    @relation(fields: [counterpartyId], references: [id])
  workOrders     WorkOrder[]
  purchaseOrders PurchaseOrder[]

  @@index([orgId, counterpartyId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("counterparty_contracts")
}

model CustomerGarage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String    @db.Uuid
  counterpartyId String    @db.Uuid
  name           String
  address        String?
  notes          String?
  isDefault      Boolean   @default(false)
  syncVersion    BigInt    @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  vehicles     Vehicle[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("customer_garages")
}

model Vehicle {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String    @db.Uuid
  customerGarageId  String    @db.Uuid
  vin               String?
  licensePlate      String?
  make              String
  model             String
  year              Int?
  engineVolume      Float?
  fuelType          String?
  currentMileage    Int?
  color             String?
  notes             String?
  transmissionType  String?
  driveType         String?
  bodyType          String?
  engineCode        String?
  insuranceExpiry   DateTime?
  inspectionExpiry  DateTime?
  syncVersion       BigInt    @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  customerGarage        CustomerGarage         @relation(fields: [customerGarageId], references: [id])
  vehicleNodes          VehicleNode[]
  workOrders            WorkOrder[]
  maintenanceSchedules  MaintenanceSchedule[]

  @@index([orgId, deletedAt])
  @@index([orgId, vin])
  @@index([orgId, syncVersion])
  @@map("vehicles")
}

model VehicleNode {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String    @db.Uuid
  vehicleId        String    @db.Uuid
  category         String
  name             String
  mileageAtInstall Int?
  notes            String?
  syncVersion      BigInt    @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([orgId, vehicleId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("vehicle_nodes")
}

// ─── SERVICE CATALOG ─────────────────────────────────────

model WorkCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  parentId    String?   @db.Uuid
  name        String
  code        String?
  icon        String?
  sortOrder   Int       @default(0)
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent                 WorkCategory?          @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children               WorkCategory[]         @relation("CategoryHierarchy")
  works                  Work[]
  employeeWorkCategories EmployeeWorkCategory[]
  goodLinks              WorkGoodCategoryLink[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("work_categories")
}

model GoodCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  parentId    String?   @db.Uuid
  name        String
  code        String?
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent    GoodCategory?  @relation("GoodCatHierarchy", fields: [parentId], references: [id])
  children  GoodCategory[] @relation("GoodCatHierarchy")
  goods     Good[]
  workLinks WorkGoodCategoryLink[]

  @@index([orgId, deletedAt])
  @@index([orgId, parentId])
  @@index([orgId, syncVersion])
  @@map("good_categories")
}

model WorkGoodCategoryLink {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String @db.Uuid
  workCategoryId String @db.Uuid
  goodCategoryId String @db.Uuid

  workCategory WorkCategory @relation(fields: [workCategoryId], references: [id])
  goodCategory GoodCategory @relation(fields: [goodCategoryId], references: [id])

  @@unique([orgId, workCategoryId, goodCategoryId])
  @@index([orgId, workCategoryId])
  @@index([orgId, goodCategoryId])
  @@map("work_good_category_links")
}

model Work {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  categoryId  String    @db.Uuid
  name        String
  normoHours  Float
  price       Decimal   @db.Decimal(12, 2)
  description String?
  isWarranty  Boolean   @default(false)
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category       WorkCategory    @relation(fields: [categoryId], references: [id])
  serviceWorks   ServiceWork[]
  workOrderLines WorkOrderLine[]
  invoiceLines   InvoiceLine[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("works")
}

model Brand {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  name        String
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  goods        Good[]
  pricingRules PricingRule[]

  @@unique([orgId, name])
  @@index([orgId, deletedAt])
  @@map("brands")
}

model Good {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @db.Uuid
  brandId         String?   @db.Uuid
  unitId          String?   @db.Uuid
  goodCategoryId  String?   @db.Uuid
  sku             String?
  name            String
  unit            String    @default("шт")
  purchasePrice   Decimal?  @db.Decimal(12, 2)
  salePrice       Decimal   @db.Decimal(12, 2)
  category        String?
  barcode         String?
  notes           String?
  syncVersion     BigInt    @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  goodType            GoodType?
  preferredSupplierId String?   @db.Uuid

  brand              Brand?             @relation(fields: [brandId], references: [id])
  unitOfMeasure      UnitOfMeasure?     @relation(fields: [unitId], references: [id])
  goodCategory       GoodCategory?      @relation(fields: [goodCategoryId], references: [id])
  preferredSupplier  Counterparty?      @relation("GoodSupplier", fields: [preferredSupplierId], references: [id])
  barcodes           GoodBarcode[]
  uoms               GoodUoM[]
  stockItems         StockItem[]
  movements          StockMovement[]
  serviceGoods       ServiceGood[]
  workOrderParts     WorkOrderPart[]
  purchaseOrderLines PurchaseOrderLine[]
  stockDocumentLines StockDocumentLine[]
  invoiceLines       InvoiceLine[]
  stockBatches       StockBatch[]
  pricingRules       PricingRule[]
  priceHistory       PriceHistory[]

  @@index([orgId, deletedAt])
  @@index([orgId, sku])
  @@index([orgId, goodType, deletedAt])
  @@index([orgId, syncVersion])
  @@map("goods")
}

model GoodBarcode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @db.Uuid
  goodId    String   @db.Uuid
  barcode   String
  type      String   @default("EAN13")
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  good      Good     @relation(fields: [goodId], references: [id], onDelete: Cascade)

  @@index([orgId, barcode])
  @@index([orgId, goodId])
  @@map("good_barcodes")
}

model GoodUoM {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @db.Uuid
  goodId          String        @db.Uuid
  unitOfMeasureId String        @db.Uuid
  isDefault       Boolean       @default(false)
  coefficient     Float         @default(1)
  width           Float?
  height          Float?
  depth           Float?
  volume          Float?
  weight          Float?
  createdAt       DateTime      @default(now())

  good            Good          @relation(fields: [goodId], references: [id], onDelete: Cascade)
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])

  @@unique([orgId, goodId, unitOfMeasureId])
  @@index([orgId, goodId])
  @@map("good_uom")
}

model UnitOfMeasure {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  name        String
  shortName   String
  isSystem    Boolean   @default(false)
  coefficient Float     @default(1)
  width       Float?
  height      Float?
  depth       Float?
  volume      Float?
  weight      Float?
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  goods               Good[]
  goodUoms            GoodUoM[]
  stockBatches        StockBatch[]        @relation("StockBatchUoM")
