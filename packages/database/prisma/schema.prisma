  @@map("bank_accounts")
}

model CashRegister {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  name        String
  currencyId  String    @db.Uuid
  branchId    String    @db.Uuid
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
