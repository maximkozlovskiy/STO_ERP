  vehicleId        String            @db.Uuid
  counterpartyId   String            @db.Uuid
  contractId       String?           @db.Uuid
  liftId           String?           @db.Uuid
  number           String
  status           WorkOrderStatus   @default(DRAFT)
  priority         WorkOrderPriority @default(NORMAL)
  repairCategory   RepairCategory?
  description      String?
  inMileage        Int?
  outMileage       Int?
  plannedAt        DateTime?
  dueDate          DateTime?
  plannedHours     Float?
  actualHours      Float?
  completedAt      DateTime?
  warrantyUntil    DateTime?
  clientApproval   Boolean           @default(false)
  totalLabor       Decimal           @default(0) @db.Decimal(12, 2)
  totalActualLabor Decimal           @default(0) @db.Decimal(12, 2)
  totalParts       Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal           @default(0) @db.Decimal(12, 2)
  totalVat         Decimal           @default(0) @db.Decimal(12, 2)
  paidAmount       Decimal           @default(0) @db.Decimal(12, 2)
  documentDate     DateTime          @default(now()) @db.Date
  shareToken       String?           @unique
  syncVersion      BigInt            @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  branch           GarageBranch          @relation(fields: [branchId], references: [id])
  vehicle          Vehicle               @relation(fields: [vehicleId], references: [id])
  counterparty     Counterparty          @relation(fields: [counterpartyId], references: [id])
  contract         CounterpartyContract? @relation(fields: [contractId], references: [id])
  lift             Lift?                 @relation(fields: [liftId], references: [id])
  lines            WorkOrderLine[]
  parts            WorkOrderPart[]
  payments         Payment[]
  invoices         Invoice[]
  calendarSlots    CalendarSlot[]
  completionActs   CompletionAct[]
  media            WorkOrderMedia[]
  warranties       Warranty[]
  claimWarranties  Warranty[]            @relation("WarrantyClaim")
  inspectionReport InspectionReport?

  @@index([orgId, status, deletedAt])
  @@index([orgId, status, branchId, deletedAt])
  @@index([orgId, syncVersion])
  @@index([orgId, counterpartyId])
  @@index([orgId, branchId, deletedAt])
  @@index([orgId, completedAt, deletedAt])
  @@index([orgId, documentDate, deletedAt])
  // FK index for liftId — supports "work orders by lift" queries (dashboards,
  // utilization reports). Partial-style not required because nullable FK is
  // sparse and B-tree skips NULL by default.
  @@index([orgId, liftId])
  // Covering для default sort: WHERE (orgId, deletedAt) + ORDER BY createdAt DESC + take 20.
  // Same convention as Invoice/PurchaseOrder/StockDocument — eliminates the in-memory Sort node
  // for the most common list query (no filters applied).
  @@index([orgId, deletedAt, createdAt])
  @@map("work_orders")
}

