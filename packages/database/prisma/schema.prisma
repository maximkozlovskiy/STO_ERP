// ─── COMPLETION ACTS ─────────────────────────────────────

model CompletionAct {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String              @db.Uuid
  workOrderId String              @db.Uuid
  number      String
  status      CompletionActStatus @default(DRAFT)
  signedAt    DateTime?
  signedBy    String?
  clientPhone String?
  notes       String?
  syncVersion BigInt              @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@unique([orgId, number])
  // Covering: findAll(orgId, workOrderId?) sorted by createdAt DESC + take 100.
  // Замінює `(orgId, workOrderId, deletedAt)` → робить Index Scan + sort node у 0.
  @@index([orgId, workOrderId, deletedAt, createdAt])
  @@index([orgId, syncVersion])
  @@map("completion_acts")
}

// ─── WORK ORDER MEDIA (B12) ──────────────────────────────

model WorkOrderMedia {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @db.Uuid
  workOrderId String   @db.Uuid
  fileKey     String
  filename    String
  mimeType    String
  sizeBytes   Int
  uploadedBy  String   @db.Uuid
  createdAt   DateTime @default(now())
  syncVersion BigInt   @default(0)

  org       Organisation @relation(fields: [orgId], references: [id])
  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id])
  uploader  Employee     @relation(fields: [uploadedBy], references: [id])

  // Covering index: findAll сортує по createdAt DESC (work-order-media.service.findAll, take:50).
  // Раніше (orgId, workOrderId) покривав WHERE але вимагав Sort node поверх Index Scan.
  // (orgId, workOrderId, createdAt) → Postgres віддає рядки в індекс-order, sort node зникає.
  @@index([orgId, workOrderId, createdAt])
  @@index([orgId, syncVersion])
  @@map("work_order_media")
}

// ─── WARRANTY (B3) ───────────────────────────────────────

model Warranty {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @db.Uuid
  workOrderId     String    @db.Uuid
  workOrderLineId String?   @db.Uuid
  workOrderPartId String?   @db.Uuid
  counterpartyId  String    @db.Uuid
  expiresAt       DateTime
  description     String    @default("")
  claimedAt       DateTime?
  claimWoId       String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  syncVersion     BigInt    @default(0)

  org          Organisation @relation(fields: [orgId], references: [id])
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  claimWo      WorkOrder?   @relation("WarrantyClaim", fields: [claimWoId], references: [id])

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  // Covering index: findByCounterparty/findByWorkOrder сортують по createdAt DESC,
  // findExpiring сортує по expiresAt ASC. Раніше (orgId, counterpartyId, deletedAt) без
  // createdAt → Sort node поверх Index Scan. Додаємо createdAt у covering для DESC-sort.
  @@index([orgId, counterpartyId, deletedAt, createdAt])
  @@index([orgId, expiresAt, deletedAt])
  // Covering index for getLinkedDocuments + getLinkedCounts (linked-docs panel).
  // WHERE: workOrderId/orgId/deletedAt + ORDER BY createdAt DESC.
  @@index([orgId, workOrderId, deletedAt, createdAt])
  @@map("warranties")
}

// ─── AUDIT EVENTS (B11) ──────────────────────────────────

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  userId     String   @db.Uuid
  diff       Json     @default("{}")
  createdAt  DateTime @default(now())

  org  Organisation @relation(fields: [orgId], references: [id])
  user Employee     @relation(fields: [userId], references: [id])

  // Covering index for findByEntity (entity timeline tab): WHERE orgId/entityType/entityId
  // + ORDER BY createdAt DESC. Without createdAt in the index, Postgres sorts matching rows in memory.
  @@index([orgId, entityType, entityId, createdAt])
  @@index([orgId, createdAt])
  @@map("audit_events")
}

// ─── INSPECTION REPORT (B1) ──────────────────────────────

model InspectionReport {
