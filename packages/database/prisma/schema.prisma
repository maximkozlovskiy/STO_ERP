generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  RECEPTIONIST
  MECHANIC
  STOREKEEPER
  ACCOUNTANT
  XLSX_MANAGER
  CLIENT
}

enum WorkOrderStatus {
  DRAFT
  ESTIMATE
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  INVOICED
  PAID
  ARCHIVED
  CANCELLED
}

enum ZoneType {
  MECHANICAL
  BODY
  TIRE
  WASH
  ELECTRICAL
  OTHER
}

enum LiftType {
  TWO_POST
  FOUR_POST
  ALIGNMENT
  STENCIL
  STAND
  PIT
  RAMP
  OTHER
}

enum WarehouseType {
  MAIN
  WORKSHOP
  TIRE_HOTEL
  MOBILE
}

enum CounterpartyType {
  CLIENT
  SUPPLIER
  BOTH
}

enum StockMovementType {
  RECEIPT
  WRITEOFF
  TRANSFER
  RESERVATION
  RESERVATION_RELEASE
  OPENING_BALANCE
}

enum StockDocumentType {
  WRITEOFF
  TRANSFER
  OPENING_BALANCE
  RECEIPT
}

enum StockDocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum DocumentType {
  WORK_ORDER
  INVOICE
  PURCHASE_ORDER
  SUPPLIER_RETURN
  STOCK_RECEIPT
  STOCK_WRITEOFF
  STOCK_TRANSFER
  STOCK_OPENING
  RECONCILIATION_ACT
  COMPLETION_ACT
  COUNTERPARTY_AGREEMENT
  GOOD_INTERNAL_CODE
  SUPPLIER_PAYMENT
}

enum ContractType {
  PURCHASE
  SALE
}

enum ResetPeriod {
  NEVER
  YEARLY
  MONTHLY
}

enum VatMode {
  NONE
  EXCLUSIVE
  INCLUSIVE
}

enum NotificationEventType {
  WO_CREATED
  WO_ESTIMATE_READY
  WO_APPROVED
  WO_IN_PROGRESS
  WO_COMPLETED
  WO_READY_FOR_PICKUP
  PAYMENT_RECEIVED
  INVOICE_SENT
  LOW_STOCK_ALERT
  FOLLOWUP_REMINDER
  BOOKING_CONFIRMATION
}

enum NotificationChannel {
  SMS
  VIBER
  EMAIL
  TELEGRAM
}

// Статус спроби доставки (per-канал). SENT = провайдер прийняв у чергу (accepted);
// REJECTED = провайдер відхилив (переходимо до наступного каналу у fallback);
// FAILED = вичерпано ретраї/усі канали. QUEUED = у процесі.
enum NotificationDeliveryStatus {
  QUEUED
  SENT
  REJECTED
  FAILED
}

enum FiscalReceiptStatus {
  QUEUED // у черзі на фіскалізацію
  DONE // чек пробито (fiscalReceiptId заповнено)
  FAILED // вичерпано ретраї (fiscalError містить причину)
  SKIPPED // фіскалізація вимкнена на філії, хоча метод її потребує
}

enum CashShiftStatus {
  OPEN // зміна відкрита — чеки пробиваються
  CLOSED // зміна закрита (Z-звіт зроблено)
}

enum ShiftMode {
  MANUAL // касир вручну відкриває/закриває зміну
  AUTO_OPEN // зміна авто-відкривається перед першим чеком (Z-звіт усе одно ручний)
}

enum OnlinePaymentStatus {
  PENDING // намір створено, чекаємо підтвердження gateway (polling)
  PAID // gateway підтвердив — Payment створено (paymentId заповнено)
  FAILED // gateway відхилив
  EXPIRED // клієнт не оплатив у відведений час
}

enum SettlementTransactionType {
  CHARGE
  PAYMENT
  REFUND
  PREPAYMENT
  CREDIT_NOTE
  // Постачальницькі типи — окрема семантика знаку (див. BALANCE_SIGN у settlements.service):
  // ми отримали товар → ми винні (balance↓); заплатили/повернули → борг меншає (balance↑).
  // Клієнтські CHARGE(+1)/PAYMENT(−1) НЕ можна переюзати — знак протилежний.
  SUPPLIER_CHARGE
  SUPPLIER_PAYMENT
  SUPPLIER_REFUND
}

// ─── PHASE 17 ENUMS ──────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  PARTIAL
  CANCELLED
}

enum SupplierReturnStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SupplierPaymentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum PaymentSourceType {
  BANK_ACCOUNT
  CASH_REGISTER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum MovementDocumentType {
  WORK_ORDER
  PURCHASE_ORDER
  SUPPLIER_RETURN
  STOCK_DOCUMENT
  MANUAL
}

enum CalendarSlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum CalendarSlotType {
  WORK
  MAINTENANCE
  BREAK
  MEETING
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  FIRED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RepairCategory {
  MAINTENANCE
  CURRENT_REPAIR
  MAJOR_REPAIR
  BODY_REPAIR
  DIAGNOSTICS
  WARRANTY
  SEASONAL
}

enum GoodType {
  SPARE_PART
  CONSUMABLE
  MATERIAL
  TOOL
}

enum LegalForm {
  INDIVIDUAL
  FOP
  TOV
  AT
  PP
  OTHER
}

enum LiftStatus {
  ACTIVE
  MAINTENANCE
  BROKEN
  DECOMMISSIONED
}

enum CompletionActStatus {
  DRAFT
  SIGNED
  CANCELLED
}

// ─── PHASE 19 ENUMS ──────────────────────────────────────

enum BatchCostMethod {
  FIFO
  FEFO
  LIFO
  AVG_COST
}

enum PricingRuleType {
  PERCENT
  FIXED_AMOUNT
  FIXED_PRICE
  COMPETITOR_PLUS
  COST_TIER
}

// ─── INFRASTRUCTURE ──────────────────────────────────────

model Organisation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @db.Uuid
  name          String
  edrpou        String?   @unique
  logoUrl       String?
  legalAddress  String?
  actualAddress String?
  bankAccountId String?   @db.Uuid
  syncVersion   BigInt    @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  branches              GarageBranch[]
  employees             Employee[]
  counterparties        Counterparty[]
  documentNumberConfigs DocumentNumberConfig[]
  settings              OrganisationSettings?
  notificationTemplates NotificationTemplate[]
  taxRates              TaxRate[]
  paymentMethods        PaymentMethodConfig[]
  employeeBranches      EmployeeBranch[]
  comments              Comment[]
  workOrderTemplates    WorkOrderTemplate[]
  workOrderMedia        WorkOrderMedia[]
  auditEvents           AuditEvent[]
  warranties            Warranty[]
  inspectionReports     InspectionReport[]
  webhookEndpoints      WebhookEndpoint[]
  loyaltyAccounts       LoyaltyAccount[]
  bookingRequests       BookingRequest[]
  currencies            Currency[]
  exchangeRates         ExchangeRate[]
  bankAccounts          BankAccount[]
  cashRegisters         CashRegister[]
  savedReports          SavedReport[]
  primaryBankAccount    BankAccount?           @relation("OrgPrimaryBankAccount", fields: [bankAccountId], references: [id])

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("organisations")
}

/// Збережена конфігурація звіту конструктора (report-builder). config — ReportConfig як JSON.
model SavedReport {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  name        String
  entity      String // ключ реєстру (валідність — на app-рівні при run)
  config      Json
  createdBy   String?   @db.Uuid
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("saved_reports")
}

model AuthAccount {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String    @db.Uuid
  employeeId   String    @unique @db.Uuid
  email        String
  passwordHash String
  syncVersion  BigInt    @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  // @@unique([orgId, email]) already creates a btree index on (orgId, email),
  // used by both uniqueness enforcement AND equality lookups (orgId_email composite key).
  // A separate @@index([orgId, email]) was redundant — dropped to reduce write overhead
  // on every AuthAccount INSERT/UPDATE (every employee create/update with login).
  @@unique([orgId, email])
  @@index([orgId, syncVersion])
  @@map("auth_accounts")
}

model GarageBranch {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  name        String
  address     String
  timezone    String    @default("Europe/Kyiv")
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  org              Organisation     @relation(fields: [orgId], references: [id])
  zones            Zone[]
  warehouses       Warehouse[]
  branchSettings   BranchSettings?
  notificationChannelConfigs NotificationChannelConfig[]
  workOrders       WorkOrder[]
  stockDocuments   StockDocument[]
  employeeBranches EmployeeBranch[]
  bookingRequests  BookingRequest[]
  bankAccounts     BankAccount[]
  cashRegisters    CashRegister[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("garage_branches")
}

model Zone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  branchId    String    @db.Uuid
  name        String
  type        ZoneType
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branch        GarageBranch   @relation(fields: [branchId], references: [id])
  lifts         Lift[]
  employeeZones EmployeeZone[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("zones")
}

model Lift {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                   String     @db.Uuid
  zoneId                  String     @db.Uuid
  name                    String
  type                    LiftType
  maxWeightKg             Int?
  status                  LiftStatus @default(ACTIVE)
  serialNumber            String?
  purchaseDate            DateTime?
  warrantyUntil           DateTime?
  maintenanceIntervalDays Int?
  lastMaintenanceDate     DateTime?
  nextMaintenanceDate     DateTime?
  syncVersion             BigInt     @default(0)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  deletedAt               DateTime?

  zone           Zone            @relation(fields: [zoneId], references: [id])
  employeeLifts  EmployeeLift[]
  calendarSlots  CalendarSlot[]
  workOrderLines WorkOrderLine[]
  workOrders     WorkOrder[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("lifts")
}

model Warehouse {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String        @db.Uuid
  branchId    String        @db.Uuid
  name        String
  type        WarehouseType @default(MAIN)
  isMain      Boolean       @default(false)
  syncVersion BigInt        @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  branch               GarageBranch     @relation(fields: [branchId], references: [id])
  stockItems           StockItem[]
  movements            StockMovement[]
  workOrderParts       WorkOrderPart[]
  purchaseOrders       PurchaseOrder[]
  supplierReturns      SupplierReturn[]
  stockDocumentsSource StockDocument[]  @relation("SourceWarehouse")
  stockDocumentsTarget StockDocument[]  @relation("TargetWarehouse")
  stockBatches         StockBatch[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("warehouses")
}

// ─── EMPLOYEES ───────────────────────────────────────────

model Employee {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String         @db.Uuid
  userId      String?        @db.Uuid
  firstName   String
  lastName    String
  phone       String?
  email       String?
  role        UserRole
  status      EmployeeStatus @default(ACTIVE)
  rateScheme  Json
  dateOfHire  DateTime?
  dateOfFire  DateTime?
  syncVersion BigInt         @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  allBranches Boolean @default(false)

  org                    Organisation            @relation(fields: [orgId], references: [id])
  employeeZones          EmployeeZone[]
  employeeLifts          EmployeeLift[]
  employeeWorkCategories EmployeeWorkCategory[]
  workOrderLines         WorkOrderLine[]
  workOrderLineAssists   WorkOrderLineEmployee[]
  authAccount            AuthAccount?
  employeeBranches       EmployeeBranch[]
  comments               Comment[]
  uploadedMedia          WorkOrderMedia[]
  auditEvents            AuditEvent[]
  inspectionReports      InspectionReport[]
  preferences            UserPreference[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("employees")
}

model EmployeeZone {
  employeeId String   @db.Uuid
  zoneId     String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])
  zone       Zone     @relation(fields: [zoneId], references: [id])

  @@id([employeeId, zoneId])
  @@map("employee_zones")
}

model EmployeeLift {
  employeeId String   @db.Uuid
  liftId     String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])
  lift       Lift     @relation(fields: [liftId], references: [id])

  @@id([employeeId, liftId])
  @@map("employee_lifts")
}

model EmployeeWorkCategory {
  employeeId     String       @db.Uuid
  workCategoryId String       @db.Uuid
  employee       Employee     @relation(fields: [employeeId], references: [id])
  workCategory   WorkCategory @relation(fields: [workCategoryId], references: [id])

  @@id([employeeId, workCategoryId])
  @@map("employee_work_categories")
}

// B10: Branch ACL
model EmployeeBranch {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @db.Uuid
  branchId   String   @db.Uuid
  orgId      String   @db.Uuid
  createdAt  DateTime @default(now())

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   GarageBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId])
  // sto-optimize: @@index([employeeId]) is redundant — @@unique([employeeId, branchId])
  // already creates a B-tree that serves equality lookups on (employeeId) alone.
  @@index([orgId])
  @@map("employee_branches")
}

// F8: Comments (polymorphic)
model Comment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @db.Uuid
  entityType  String
  entityId    String   @db.Uuid
  body        String
  authorId    String   @db.Uuid
  createdAt   DateTime @default(now())
  syncVersion BigInt   @default(0)

  org    Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author Employee     @relation(fields: [authorId], references: [id])

  @@index([orgId, entityType, entityId, createdAt])
  @@index([orgId, syncVersion])
  @@map("comments")
}

// F10: Work Order Templates
model WorkOrderTemplate {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  name        String
  lines       Json      @default("[]")
  parts       Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  syncVersion BigInt    @default(0)

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, deletedAt])
  @@map("work_order_templates")
}

// ─── CRM ─────────────────────────────────────────────────

model Counterparty {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String           @db.Uuid
  type          CounterpartyType
  firstName     String?
  lastName      String?
  companyName   String?
  edrpou        String?
  vatPayer      Boolean          @default(false)
  phone         String?
  email         String?
  notes         String?
  legalForm     LegalForm?
  legalAddress  String?
  actualAddress String?
  bankAccount   String?
  bankName      String?
  contactPerson String?
  taxNumber     String?
  syncVersion   BigInt           @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  org                Organisation           @relation(fields: [orgId], references: [id])
  customerGarages    CustomerGarage[]
  contracts          CounterpartyContract[]
  settlementAccount  SettlementAccount?
  loyaltyAccount     LoyaltyAccount?
  purchaseOrders     PurchaseOrder[]
  supplierReturns    SupplierReturn[]
  supplierPayments   SupplierPayment[]
  invoices           Invoice[]
  workOrders         WorkOrder[]
  payments           Payment[]
  reconciliationActs ReconciliationAct[]
  goodsAsSupplier    Good[]                 @relation("GoodSupplier")
  pricingRules       PricingRule[]          @relation("PricingRuleSupplier")
  warranties         Warranty[]
  calendarSlots      CalendarSlot[]

  @@index([orgId, deletedAt])
  @@index([orgId, type, deletedAt])
  @@index([orgId, syncVersion])
  @@map("counterparties")
}

model CounterpartyContract {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String       @db.Uuid
  counterpartyId   String       @db.Uuid
  number           String
  contractType     ContractType
  startDate        DateTime     @db.Date
  endDate          DateTime?    @db.Date
  isPrimary        Boolean      @default(false)
  creditLimit      Decimal?     @db.Decimal(15, 2)
  currencyCode     String       @default("UAH") @db.VarChar(10)
  paymentDeferDays Int?
  syncVersion      BigInt       @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  counterparty   Counterparty    @relation(fields: [counterpartyId], references: [id])
  workOrders     WorkOrder[]
  purchaseOrders PurchaseOrder[]

  @@index([orgId, counterpartyId, deletedAt])
  // sto-optimize (2026-08-30): hot-path getSchedule — filter by (orgId, contractType='PURCHASE'),
  // не використовує counterpartyId — існуючий базовий індекс не покривав.
  @@index([orgId, contractType, deletedAt])
  @@index([orgId, syncVersion])
  @@map("counterparty_contracts")
}

model CustomerGarage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String    @db.Uuid
  counterpartyId String    @db.Uuid
  name           String
  address        String?
  notes          String?
  isDefault      Boolean   @default(false)
  syncVersion    BigInt    @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  vehicles     Vehicle[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("customer_garages")
}

model Vehicle {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String    @db.Uuid
  customerGarageId String    @db.Uuid
  vin              String?
  licensePlate     String?
  make             String
  model            String
  year             Int?
  engineVolume     Float?
  fuelType         String?
  currentMileage   Int?
  color            String?
  notes            String?
  transmissionType String?
  driveType        String?
  bodyType         String?
  engineCode       String?
  insuranceExpiry  DateTime?
  inspectionExpiry DateTime?
  syncVersion      BigInt    @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  customerGarage       CustomerGarage        @relation(fields: [customerGarageId], references: [id])
  vehicleNodes         VehicleNode[]
  workOrders           WorkOrder[]
  maintenanceSchedules MaintenanceSchedule[]
  calendarSlots        CalendarSlot[]

  @@index([orgId, deletedAt])
  @@index([orgId, vin])
  @@index([orgId, syncVersion])
  @@map("vehicles")
}

model VehicleNode {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String    @db.Uuid
  vehicleId        String    @db.Uuid
  category         String
  name             String
  mileageAtInstall Int?
  notes            String?
  syncVersion      BigInt    @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([orgId, vehicleId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("vehicle_nodes")
}

// ─── SERVICE CATALOG ─────────────────────────────────────

model WorkCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  parentId    String?   @db.Uuid
  name        String
  code        String?
  icon        String?
  sortOrder   Int       @default(0)
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent                 WorkCategory?          @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children               WorkCategory[]         @relation("CategoryHierarchy")
  works                  Work[]
  employeeWorkCategories EmployeeWorkCategory[]
  goodLinks              WorkGoodCategoryLink[]

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  @@map("work_categories")
}

model GoodCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  parentId    String?   @db.Uuid
  name        String
  code        String?
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent    GoodCategory?          @relation("GoodCatHierarchy", fields: [parentId], references: [id])
  children  GoodCategory[]         @relation("GoodCatHierarchy")
  goods     Good[]
  workLinks WorkGoodCategoryLink[]

  @@index([orgId, deletedAt])
  @@index([orgId, parentId])
  @@index([orgId, syncVersion])
  @@map("good_categories")
}

model WorkGoodCategoryLink {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String @db.Uuid
  workCategoryId String @db.Uuid
  goodCategoryId String @db.Uuid

  workCategory WorkCategory @relation(fields: [workCategoryId], references: [id])
  goodCategory GoodCategory @relation(fields: [goodCategoryId], references: [id])

  @@unique([orgId, workCategoryId, goodCategoryId])
  @@index([orgId, workCategoryId])
  @@index([orgId, goodCategoryId])
  @@map("work_good_category_links")
}

model Work {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  categoryId  String    @db.Uuid
  name        String
  normoHours  Float
  price       Decimal   @db.Decimal(12, 2)
  description String?
  isWarranty  Boolean   @default(false)
  syncVersion BigInt    @default(0)
  createdAt   DateTime  @default(now())
