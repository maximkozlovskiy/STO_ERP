  invoice       Invoice        @relation(fields: [invoiceId], references: [id])
  good          Good?          @relation(fields: [goodId], references: [id])
  work          Work?          @relation(fields: [workId], references: [id])
  unitOfMeasure UnitOfMeasure? @relation("InvoiceLineUoM", fields: [unitOfMeasureId], references: [id])

  @@index([orgId, invoiceId])
  @@map("invoice_lines")
}

// ─── MAINTENANCE SCHEDULES ───────────────────────────────

model MaintenanceSchedule {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                  String    @db.Uuid
  vehicleId              String    @db.Uuid
  maintenanceType        String    @default("REGULAR")
  intervalDays           Int?
  intervalMileage        Int?
  lastMaintenanceDate    DateTime?
  lastMaintenanceMileage Int?
  nextMaintenanceDate    DateTime?
  nextMaintenanceMileage Int?
  notes                  String?
  isActive               Boolean   @default(true)
  syncVersion            BigInt    @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([orgId, vehicleId, deletedAt])
  @@index([orgId, nextMaintenanceDate])
  @@index([orgId, syncVersion])
  @@map("maintenance_schedules")
}

// ─── COMPLETION ACTS ─────────────────────────────────────

model CompletionAct {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String              @db.Uuid
  workOrderId String              @db.Uuid
  number      String
  status      CompletionActStatus @default(DRAFT)
  signedAt    DateTime?
  signedBy    String?
  clientPhone String?
  notes       String?
  syncVersion BigInt              @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@unique([orgId, number])
  // Covering: findAll(orgId, workOrderId?) sorted by createdAt DESC + take 100.
  // Замінює `(orgId, workOrderId, deletedAt)` → робить Index Scan + sort node у 0.
  @@index([orgId, workOrderId, deletedAt, createdAt])
  @@index([orgId, syncVersion])
  @@map("completion_acts")
}

// ─── WORK ORDER MEDIA (B12) ──────────────────────────────

model WorkOrderMedia {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @db.Uuid
  workOrderId String   @db.Uuid
  fileKey     String
  filename    String
  mimeType    String
  sizeBytes   Int
  uploadedBy  String   @db.Uuid
  createdAt   DateTime @default(now())
  syncVersion BigInt   @default(0)

  org       Organisation @relation(fields: [orgId], references: [id])
  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id])
  uploader  Employee     @relation(fields: [uploadedBy], references: [id])

  // Covering index: findAll сортує по createdAt DESC (work-order-media.service.findAll, take:50).
  // Раніше (orgId, workOrderId) покривав WHERE але вимагав Sort node поверх Index Scan.
  // (orgId, workOrderId, createdAt) → Postgres віддає рядки в індекс-order, sort node зникає.
  @@index([orgId, workOrderId, createdAt])
  @@index([orgId, syncVersion])
  @@map("work_order_media")
}

// ─── WARRANTY (B3) ───────────────────────────────────────

model Warranty {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String    @db.Uuid
  workOrderId       String    @db.Uuid
  workOrderLineId   String?   @db.Uuid
  workOrderPartId   String?   @db.Uuid
  counterpartyId    String    @db.Uuid
  expiresAt         DateTime
  description       String    @default("")
  claimedAt         DateTime?
  claimWoId         String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  syncVersion       BigInt    @default(0)

  org          Organisation @relation(fields: [orgId], references: [id])
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  claimWo      WorkOrder?   @relation("WarrantyClaim", fields: [claimWoId], references: [id])

  @@index([orgId, deletedAt])
  @@index([orgId, syncVersion])
  // Covering index: findByCounterparty/findByWorkOrder сортують по createdAt DESC,
  // findExpiring сортує по expiresAt ASC. Раніше (orgId, counterpartyId, deletedAt) без
  // createdAt → Sort node поверх Index Scan. Додаємо createdAt у covering для DESC-sort.
  @@index([orgId, counterpartyId, deletedAt, createdAt])
  @@index([orgId, expiresAt, deletedAt])
  @@map("warranties")
}

// ─── AUDIT EVENTS (B11) ──────────────────────────────────

model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  userId     String   @db.Uuid
  diff       Json     @default("{}")
  createdAt  DateTime @default(now())

  org  Organisation @relation(fields: [orgId], references: [id])
  user Employee     @relation(fields: [userId], references: [id])

  // Covering index for findByEntity (entity timeline tab): WHERE orgId/entityType/entityId
  // + ORDER BY createdAt DESC. Without createdAt in the index, Postgres sorts matching rows in memory.
  @@index([orgId, entityType, entityId, createdAt])
  @@index([orgId, createdAt])
  @@map("audit_events")
}

// ─── INSPECTION REPORT (B1) ──────────────────────────────

model InspectionReport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @db.Uuid
  workOrderId String   @db.Uuid
  mileage     Int?
  points      Json     @default("[]")
  createdBy   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  syncVersion BigInt   @default(0)

  org       Organisation @relation(fields: [orgId], references: [id])
  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id])
  employee  Employee     @relation(fields: [createdBy], references: [id])

  @@unique([workOrderId])
  @@index([orgId, syncVersion])
  @@map("inspection_reports")
}

// ─── WEBHOOKS (B5) ───────────────────────────────────────

model WebhookEndpoint {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  url         String
  secret      String    @default("")
  events      String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  syncVersion BigInt    @default(0)

  org        Organisation      @relation(fields: [orgId], references: [id])
  deliveries WebhookDelivery[]

  // Covering index: findAll сортує по createdAt DESC + filter deletedAt. Без createdAt
  // у індексі Postgres робив Sort node поверх Index Scan на (orgId, deletedAt).
  @@index([orgId, deletedAt, createdAt])
  @@index([orgId, isActive])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId   String   @db.Uuid
  event        String
  payload      Json
  status       String   @default("PENDING")
  attempts     Int      @default(0)
  responseCode Int?
  responseBody String?
  createdAt    DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

// ─── CLOUD SYNC ──────────────────────────────────────────

enum SyncJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model SyncJob {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String        @db.Uuid
  tableName   String
  recordId    String        @db.Uuid
  operation   String        // INSERT | UPDATE | DELETE
  syncVersion BigInt
  payload     Json
  status      SyncJobStatus @default(PENDING)
  attempts    Int           @default(0)
  lastError   String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  @@index([orgId, status])
  @@index([orgId, tableName, syncVersion])
  @@map("sync_jobs")
}

// ─── BOOKING REQUESTS (B3) ───────────────────────────────

model BookingRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @db.Uuid
  branchId        String    @db.Uuid
  status          String    @default("PENDING")
  clientName      String
  clientPhone     String
  serviceIds      String[]
  requestedDate   DateTime
  confirmedSlotId String?   @db.Uuid
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  org    Organisation  @relation(fields: [orgId], references: [id])
  branch GarageBranch  @relation(fields: [branchId], references: [id])

  // Covering index: findAll сортує по createdAt DESC + filter deletedAt. Existing
  // (orgId, createdAt) покривав unfiltered scan; для findAll з deletedAt=null фільтром
  // (orgId, deletedAt, createdAt) даs covering без heap-read для розбраковки soft-deleted.
  @@index([orgId, status, deletedAt])
  @@index([orgId, deletedAt, createdAt])
  @@map("booking_requests")
}

