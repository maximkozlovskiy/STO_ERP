// ─── FINANCE & SETTLEMENTS ───────────────────────────────

model Invoice {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String        @db.Uuid
  counterpartyId  String        @db.Uuid
  workOrderId     String?       @db.Uuid
  number          String
  amount          Decimal       @db.Decimal(12, 2)
  // Сплачена сума (сума всіх Payment цього рахунку). Часткова оплата: status=PARTIALLY_PAID
  // поки paidAmount<amount, PAID коли paidAmount>=amount. Backfill: наявним PAID → paidAmount=amount.
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime?
  invoiceType     String        @default("INVOICE")
  notes           String?
  totalWithoutVat Decimal       @default(0) @db.Decimal(12, 2)
  totalVat        Decimal       @default(0) @db.Decimal(12, 2)
  totalWithVat    Decimal       @default(0) @db.Decimal(12, 2)
  documentDate    DateTime      @default(now()) @db.Date
  syncVersion     BigInt        @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  counterparty Counterparty  @relation(fields: [counterpartyId], references: [id])
  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id])
  payments     Payment[]
  lines        InvoiceLine[]

  @@index([orgId, status, deletedAt])
  @@index([orgId, syncVersion])
  @@index([orgId, deletedAt, createdAt])
  @@index([orgId, documentDate, deletedAt])
  // Covering index for getLinkedDocuments + getLinkedCounts (work-orders page badges,
  // modal Documents tab). WHERE: workOrderId/orgId/deletedAt + status≠CANCELLED, ORDER BY
  // createdAt DESC. Без цього індекса Postgres ішов через (orgId, status, deletedAt)
  // partial scan + per-row workOrderId filter — O(N) на кожен WO у groupBy.
  @@index([orgId, workOrderId, deletedAt, createdAt])
  @@map("invoices")
}

// Append-only — ніколи не редагується
model Payment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @db.Uuid
  counterpartyId  String   @db.Uuid
  workOrderId     String?  @db.Uuid
  invoiceId       String?  @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  method          String
  notes           String?
  fiscalReceiptId String?
  // Фіскальний статус (ПРРО). null = фіскалізація не застосовна (метод без requiresFiscal).
  // QUEUED = у черзі; DONE = чек пробито (fiscalReceiptId заповнено); FAILED = вичерпано ретраї
  // (fiscalError); SKIPPED = фіскалізація вимкнена на філії. Оновлюється processor-ом (delivery-
  // метадані — сам платіж лишається незмінним).
  fiscalStatus    FiscalReceiptStatus?
  fiscalError     String?
  // Рахунок-призначення: куди фізично лягли гроші (дзеркало SupplierPayment). null для старих
  // рядків / коли не вказано. sourceType↔(bankAccountId|cashRegisterId) узгоджені у сервісі.
  sourceType      PaymentSourceType?
  bankAccountId   String?  @db.Uuid
  cashRegisterId  String?  @db.Uuid
  // Лінк на онлайн-намір (QR monobank), з якого створено цей Payment. @unique = idempotency-guard:
  // реконсиляція наміру (PAID але paymentId ще не залінковано) може повторити payments.create після
  // збою link-write — унікальний констрейнт відкидає дубль (P2002), finalize знаходить наявний
  // Payment по цьому полю і лінкує. null для звичайних (не-онлайн) платежів. Bug #688.
  onlinePaymentIntentId String? @unique @db.Uuid
  syncVersion     BigInt   @default(0)
  createdAt       DateTime @default(now())

  counterparty Counterparty  @relation(fields: [counterpartyId], references: [id])
  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])

  @@index([orgId, workOrderId])
  // Covering: list endpoint sorts by createdAt DESC + filters by counterpartyId.
  // Замінює `(orgId, counterpartyId)` → Postgres віддає рядки в індекс-order, sort node зникає.
  @@index([orgId, counterpartyId, createdAt])
  // For unfiltered list (no counterpartyId): orgId + createdAt DESC + take
  @@index([orgId, createdAt])
  // sto-optimize (2026-09-06): invoices.getLinkedCounts робить groupBy(by: invoiceId,
  // where invoiceId IN [...до 500], orgId) на КОЖНУ сторінку списку рахунків. FK
  // payments.invoiceId мав лише FK-constraint (Postgres не індексує FK автоматично) →
  // org-wide seq/index-only scan по orgId + per-row invoiceId filter. Covering index
  // по (orgId, invoiceId) робить groupBy index-only.
  @@index([orgId, invoiceId])
  @@map("payments")
}

// Намір онлайн-оплати (QR через monobank/LiqPay). Payment створюється ЛИШЕ коли gateway
// підтвердив (polling PENDING→PAID через CAS). paymentId лінкує створений Payment (idempotency).
model OnlinePaymentIntent {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String              @db.Uuid
  gateway          String              @default("monobank")
  gatewayInvoiceId String? // invoiceId у gateway
  pageUrl          String? // сторінка оплати gateway (рендериться як QR)
  amount           Decimal             @db.Decimal(12, 2)
  counterpartyId   String              @db.Uuid
  invoiceId        String?             @db.Uuid
  workOrderId      String?             @db.Uuid
  status           OnlinePaymentStatus @default(PENDING)
  paymentId        String?             @db.Uuid // Payment, створений при PAID (idempotency-лінк)
  error            String?
  expiresAt        DateTime? // жорсткий wall-clock таймаут polling → EXPIRED
  syncVersion      BigInt              @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@map("online_payment_intents")
}

model SettlementAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @db.Uuid
  counterpartyId String   @unique @db.Uuid
  balance        Decimal  @default(0) @db.Decimal(12, 2)
  syncVersion    BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  counterparty Counterparty            @relation(fields: [counterpartyId], references: [id])
  transactions SettlementTransaction[]

  @@index([orgId])
  @@map("settlement_accounts")
}

// Append-only — ніколи не редагується
model SettlementTransaction {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String                    @db.Uuid
  settlementAccountId String                    @db.Uuid
  type                SettlementTransactionType
  amount              Decimal                   @db.Decimal(12, 2)
  documentType        String?
  documentId          String?                   @db.Uuid
  notes               String?
  createdAt           DateTime                  @default(now())
  createdBy           String?                   @db.Uuid

  account SettlementAccount @relation(fields: [settlementAccountId], references: [id])

  // Covering for getTransactions (paginated list per account) + reconciliation period scans:
  // WHERE settlementAccountId/orgId + ORDER BY createdAt DESC + sometimes BETWEEN periodFrom/periodTo.
  @@index([orgId, settlementAccountId, createdAt])
  @@index([orgId, documentType, documentId])
  // sto-optimize (2026-09-06): dashboard.getSummary "виручка сьогодні" робить
  // aggregate({ where: { orgId, type: 'PAYMENT', createdAt: { gte: todayStart } }, _sum: amount }).
  // Ця гілка НЕ фільтрує по settlementAccountId → існуючий (orgId, settlementAccountId, createdAt)
  // не вибирається (leftmost-prefix miss на settlementAccountId), (orgId, documentType, documentId) —
  // нерелевантний. Дашборд опитується SSE кожні 30s (кеш 25s) для КОЖНОГО активного користувача,
  // а settlement_transactions — append-only high-volume (кожен charge/payment/prepayment по всіх
  // контрагентах). Без цього індексу aggregate робить org-wide scan + heap-filter type+createdAt.
  // Covering (orgId, type, createdAt): type=equality → leftmost, createdAt=range → tail → index-range scan.
  @@index([orgId, type, createdAt])
  @@map("settlement_transactions")
}

model ReconciliationAct {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @db.Uuid
  counterpartyId String   @db.Uuid
  periodFrom     DateTime
  periodTo       DateTime
  openingBalance Decimal  @db.Decimal(12, 2)
  closingBalance Decimal  @db.Decimal(12, 2)
  snapshotJson   Json
  syncVersion    BigInt   @default(0)
  createdAt      DateTime @default(now())
  createdBy      String?  @db.Uuid

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])

  // sto-optimize: covering index — getReconciliationActs sortує по createdAt DESC + filter
  // по orgId+counterpartyId. Колишній (orgId, counterpartyId) без createdAt → Postgres
  // Sort node поверх Index Scan. Index-order DESC scan усуває Sort node на типовому
  // навантаженні (~200 акт. на контрагента) — index-only scan без heap-read для sort.
  @@index([orgId, counterpartyId, createdAt])
  @@index([orgId, syncVersion])
  @@map("reconciliation_acts")
}

// ─── SCHEDULING ──────────────────────────────────────────

model CalendarSlot {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String             @db.Uuid
  liftId         String?            @db.Uuid
  employeeId     String?            @db.Uuid
  workOrderId    String?            @db.Uuid
  counterpartyId String?            @db.Uuid
  vehicleId      String?            @db.Uuid
  parentSlotId   String?            @db.Uuid
  startAt        DateTime
  endAt          DateTime
  status         CalendarSlotStatus @default(BOOKED)
  type           CalendarSlotType   @default(WORK)
  notes          String?
  syncVersion    BigInt             @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  lift         Lift?          @relation(fields: [liftId], references: [id])
  workOrder    WorkOrder?     @relation(fields: [workOrderId], references: [id])
  counterparty Counterparty?  @relation(fields: [counterpartyId], references: [id])
  vehicle      Vehicle?       @relation(fields: [vehicleId], references: [id])
  parent       CalendarSlot?  @relation("SlotContinuation", fields: [parentSlotId], references: [id])
  continuation CalendarSlot[] @relation("SlotContinuation")

  @@index([orgId, deletedAt])
  @@index([orgId, startAt, deletedAt])
  @@index([orgId, liftId, startAt, endAt])
  @@index([orgId, employeeId, startAt])
  @@index([orgId, syncVersion])
  // Covering index for getLinkedDocuments + getLinkedCounts (linked-docs panel).
  // WHERE: workOrderId/orgId/deletedAt + ORDER BY startAt DESC. Без нього Postgres
  // ішов через (orgId, deletedAt) і фільтрував workOrderId по-рядково.
  @@index([orgId, workOrderId, deletedAt, startAt])
  @@map("calendar_slots")
}

// ─── INVOICE LINES ───────────────────────────────────────

model InvoiceLine {
