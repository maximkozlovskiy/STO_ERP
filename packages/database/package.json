    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed-catalog.ts && ts-node prisma/seed.ts"
  }
