# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
.next-e2e/
out/

# Environment — НІКОЛИ не комітити!
.env
.env.local
.env.*.local

# .env.dev можна комітити (без реальних секретів)
# але .env.production — ні
.env.production

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Runtime
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Prisma
packages/database/prisma/migrations/dev.db
packages/database/prisma/*.db

# Installer bundles (генеруються CI) та output
installer/bundle/*.exe
installer/bundle/images/
installer/output/

# Docker volumes (якщо монтуються локально)
.docker-data/

# TypeScript build info (генерується tsc --incremental)
*.tsbuildinfo

# pnpm
.pnpm-store/

# Playwright
apps/web/test-results/
apps/web/playwright-report/
apps/web/.playwright/
apps/web/e2e/.auth/
apps/web/.env.e2e.local
.claude/worktrees/
.turbo/cache/
# Next.js 16 dev-server авто-генерує ці файли у apps/web (self-documented «auto-generated»);
# turbopack також переписує tsconfig.json/next-env.d.ts на `next dev` — не комітимо цю dev-churn.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Vitest coverage reports
coverage/

# Проміжний JS для emit-openapi (`pnpm --filter @sto/api emit-openapi`).
# dist/ уже ігнорується, але цей каталог має інше імʼя.
apps/api/dist-openapi/

# Python bytecode (py_compile при перевірці хуків)
__pycache__/
*.pyc

# vitest-артефакти прогону: JSON-звіт для гейта A (scripts/check-spec-registry.py)
# і кеш репортера. Baseline (apps/api/test-baseline.json) — НЕ тут, він у git свідомо:
# його diff показує, які саме кейси додались або зникли.
apps/api/.vitest-report.json
apps/api/.vitest/
