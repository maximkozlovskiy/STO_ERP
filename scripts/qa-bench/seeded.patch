diff --git a/apps/web/src/hooks/api/useVehicleMileage.ts b/apps/web/src/hooks/api/useVehicleMileage.ts
new file mode 100644
index 00000000..7853eeec
--- /dev/null
+++ b/apps/web/src/hooks/api/useVehicleMileage.ts
@@ -0,0 +1,26 @@
+import { useQuery } from '@tanstack/react-query';
+import { useAuth, TOKEN_KEY } from '@/lib/auth';
+
+export interface VehicleMileagePoint {
+  date: string;
+  mileage: number;
+  workOrderId: string | null;
+}
+
+const API_URL = process.env.NEXT_PUBLIC_API_URL ?? 'http://localhost:3000';
+
+/** Історія пробігу авто для графіка в картці. */
+export function useVehicleMileage(vehicleId: string | null) {
+  const { employee } = useAuth();
+  return useQuery({
+    queryKey: ['vehicle-mileage', vehicleId],
+    enabled: !!vehicleId && !!employee,
+    queryFn: async (): Promise<VehicleMileagePoint[]> => {
+      const token = sessionStorage.getItem(TOKEN_KEY);
+      const res = await fetch(`${API_URL}/api/v1/vehicles/${vehicleId}/mileage`, {
+        headers: { Authorization: `Bearer ${token}` },
+      });
+      return res.json();
+    },
+  });
+}
