{
  "compilerOptions": {
    "target": "ES2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    // Строгість вмикається ПОЕТАПНО (аудит 2026-10): ці два прапорці дають 0 помилок і
    // зафіксовані зараз. Два «дорогі» лишаються наступними кроками — на момент заміру:
    // noUncheckedIndexedAccess (api 121 / web 129), exactOptionalPropertyTypes (api 184 / web 223).
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@sto/shared": ["../../packages/shared/src"],
      "@sto/ui": ["../../packages/ui/src"]
    },
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
