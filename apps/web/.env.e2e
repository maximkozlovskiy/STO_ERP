# E2E environment — копіюйте в .env.e2e.local для локальних перевизначень

# Локально Playwright сам піднімає E2E-екземпляр на :3002 (див. playwright.config.ts).
# :3001 — звичайний dev-сервер БЕЗ NEXT_PUBLIC_E2E: спрямувати тести туди = усі в /login.
PLAYWRIGHT_BASE_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3000

# Credentials for the E2E admin account (seed default: admin@sto.local / admin123)
E2E_EMAIL=admin@sto.local
E2E_PASSWORD=admin123
