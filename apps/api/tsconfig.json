{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "./dist",
    "lib": ["ES2022"],
    "strict": true,
    // Строгість вмикається ПОЕТАПНО (аудит 2026-10): ці два прапорці дають 0 помилок і
    // зафіксовані зараз. Два «дорогі» лишаються наступними кроками — на момент заміру:
    // noUncheckedIndexedAccess (api 121 / web 129), exactOptionalPropertyTypes (api 184 / web 223).
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts", "node_modules", "dist"]
}
