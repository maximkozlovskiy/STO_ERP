{
  "name": "sto-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @sto/database prisma generate",
    "db:migrate": "pnpm --filter @sto/database prisma migrate dev",
    "db:studio": "pnpm --filter @sto/database prisma studio",
    "db:seed": "pnpm --filter @sto/database prisma db seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "prepare": "husky",
    "deadcode": "knip --no-exit-code",
    "cycles": "madge --circular --extensions ts --ts-config apps/api/tsconfig.json apps/api/src"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^17.0.5",
    "madge": "^8.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.2.2"
}
