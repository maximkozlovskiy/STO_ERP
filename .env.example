# STO ERP — Environment Variables Example
# Скопіюй в .env.dev і заміни значення для локальної розробки

# PostgreSQL
POSTGRES_USER=sto
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=sto_erp
DATABASE_URL=postgresql://sto:your_db_password@localhost:5432/sto_erp

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=sto-files
MINIO_USE_SSL=false

# JWT (змінити на сильні секрети в production!)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Шифрування секретів at-rest (SMS/ПРРО-креди). Генерується інсталятором ОДИН раз.
# УВАГА: не змінювати після першого запуску — інакше наявні зашифровані ключі стануть
# недешифровними. Порожнє → шифрування вимкнено (plaintext, лише для dev).
NOTIFICATION_ENC_KEY=your_encryption_key_min_32_chars

# API
PORT=3000
NODE_ENV=development
TZ=Europe/Kyiv

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public-facing web URL — використовується сервером для побудови shareable посилань (SMS, email).
# В on-prem інсталяторі задається при встановленні; в dev — host веб-додатку.
WEB_PUBLIC_URL=http://localhost:3001

# Sentry (disabled in dev; in production set both DSN values)
# Отримати DSN: https://sentry.io → Settings → Projects → Client Keys
SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
